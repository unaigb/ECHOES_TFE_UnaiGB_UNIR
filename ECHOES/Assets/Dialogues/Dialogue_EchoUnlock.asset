  m_Script: {fileID: 11500000, guid: de9cc60427f64ab44925ed839f653ced, type: 3}
  m_Name: Dialogue_EchoUnlock
  m_EditorClassIdentifier: Assembly-CSharp::Echoes.Dialogue.DialogueSequence
  speakerName: Ir1s
  lines:
  - text: 'Temporal recording device: online.'
    register: 0
  - text: Press {Record} to log your movements for fifteen seconds. Press it again
      and you snap back to your starting position.
    register: 0
  - text: Press {DeployEcho} and an echo of you replays that recording while you
      act in parallel. Get it wrong and {Rewind} wipes the log.
    register: 0
  - text: Use it to hold that plate down while you cross... And maybe for something
      more.
    register: 0
