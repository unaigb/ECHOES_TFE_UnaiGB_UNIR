  m_Script: {fileID: 11500000, guid: de9cc60427f64ab44925ed839f653ced, type: 3}
  m_Name: Dialogue_Sala01_A
  m_EditorClassIdentifier: Assembly-CSharp::Echoes.Dialogue.DialogueSequence
  speakerName: Ir1s
  lines:
  - text: Subject E-0. Welcome to the Aetheria Training Complex. I'm Ir1s, your supervisor
      for the evaluation program.
    register: 0
  - text: We'll start with motor calibration. Use {Move} to walk; the body responds
      in all eight directions.
    register: 0
  - text: "There's a security door ahead. It opens from its control panel \u2014
      step up to it and press {Interact}."
    register: 0
  - text: One note. Some panels hold a door open permanently. Others only for a few
      seconds. Be aware of which is which before you act.
    register: 0
  - text: Good luck.
    register: 0
