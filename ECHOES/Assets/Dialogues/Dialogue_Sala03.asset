  m_Script: {fileID: 11500000, guid: de9cc60427f64ab44925ed839f653ced, type: 3}
  m_Name: Dialogue_Sala03
  m_EditorClassIdentifier: Assembly-CSharp::Echoes.Dialogue.DialogueSequence
  speakerName: Ir1s
  lines:
  - text: Third room. Infiltration protocol.
    register: 0
  - text: From here on, the environment includes active surveillance.
    register: 0
  - text: "That camera sweeps a vision cone. Stay inside it long enough and it trips
      the alarm \u2014 the room resets."
    register: 0
  - text: "Echoes don't register in its detection log. You could use one as\u2026
      a decoy. A distraction."
    register: 1
  - text: It's an option the exercise design accounts for. It is not a recommendation.
    register: 1
  - text: 'Try to get detected to understand how the cameras work... Or just go ahead
      and complete the room. '
    register: 1
